# ---------------------------------------------------------------------------
#  Internal Data Asset Platform - background worker (systemd)
#
#  Builds frame indexes and thumbnails so the online viewer opens instantly.
#  The platform still works without it, but imported files would show
#  "parsing" until a worker picks them up.
#
#  Install as root: see the header of data-platform-backend.service
#      cp deploy/data-platform-*.service /etc/systemd/system/
#      systemctl daemon-reload
#      systemctl enable --now data-platform-worker data-platform-backend
#
#  Apply a config change:
#      systemctl restart data-platform-worker
#
#  Logs: journalctl -u data-platform-worker -f
# ---------------------------------------------------------------------------
[Unit]
Description=Internal Data Asset Platform - background worker (frame index + thumbnails)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=platform
Group=platform
WorkingDirectory=/opt/data_asset_platform/backend
Environment=PYTHONUNBUFFERED=1
Environment=PYTHON_EXE=/opt/data_asset_platform/venv/bin/python
ExecStart=/opt/data_asset_platform/venv/bin/python -m app.worker.main
Restart=on-failure
RestartSec=3
UMask=0022
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
