# ============================================================================
#  内部数据资产管理平台 —— 唯一需要改的配置文件
#
#  改完保存，重启平台即可生效（scripts\start.bat）。
#
#  格式：
#    一行一个「键=值」，键和值两边的空格会被去掉，值两端的引号可加可不加。
#    以 # 开头的行是注释；空行忽略。**注释请另起一行**（值里不要写 #）。
#
#  优先级（高 → 低）：
#    1) 命令行 / 终端里临时设的环境变量      例：set STORAGE_ROOT=E:\tmp
#    2) 本文件
#    3) 代码里的默认值
#    本文件里出现的键会自动变成环境变量，所以 .bat 脚本和 Python 读到的是同一套值。
#
#  查看当前实际生效的值：
#      Windows :  scripts\config.bat
#      Linux   :  scripts/config.sh
#
#  Windows 和 Linux 共用这一个文件，但**路径写法不一样**：
#      Windows :  D:\data_platform\storage
#      Linux   :  /srv/data_platform/storage
#    换系统时把下面几行的路径改成目标系统的写法即可，其余一个字都不用动。
# ============================================================================


# ---------------------------------------------------------------------------
#  数据目录（换数据盘 / 搬家就改这三行）
# ---------------------------------------------------------------------------
#  实体文件按内容哈希存放在 storage 下，**换目录前先把旧目录整个拷过去**，
#  否则库里记录还在、文件没了，打开会报错。
#
#  Linux 示例（把下面三行换成这个）：
#    STORAGE_ROOT=/srv/data_platform/storage
#    DB_PATH=/srv/data_platform/data/platform.db
#    CACHE_DIR=/srv/data_platform/cache
STORAGE_ROOT=D:\data_platform\storage
DB_PATH=D:\data_platform\data\platform.db
CACHE_DIR=D:\data_platform\cache


# ---------------------------------------------------------------------------
#  服务监听
# ---------------------------------------------------------------------------
#  BIND_HOST=0.0.0.0 表示本机和局域网都能访问；只想自己用就改成 127.0.0.1
BIND_HOST=0.0.0.0
BIND_PORT=8000


# ---------------------------------------------------------------------------
#  上传
# ---------------------------------------------------------------------------
#  分片大小 8MB
#CHUNK_SIZE=8388608
#  单文件上限 10GB
#MAX_FILE_SIZE=10737418240
#  上传会话过期（小时）：断了这么久没动静就作废
#UPLOAD_SESSION_TTL_H=48


# ---------------------------------------------------------------------------
#  缓存（内存里的帧图片缓存，磁盘缓存看 CACHE_DIR）
# ---------------------------------------------------------------------------
#CACHE_MAX_BYTES=268435456
#SMALL_CACHE_MAX_BYTES=33554432


# ---------------------------------------------------------------------------
#  在线查看（播放速度与批量取帧）
# ---------------------------------------------------------------------------
#  1x 倍速下每帧间隔
#PLAYBACK_BASE_INTERVAL_MS=180
#PLAYBACK_MIN_INTERVAL_MS=40
#PLAY_BATCH_COUNT=32
#PLAY_BATCH_MAX_COUNT=64


# ---------------------------------------------------------------------------
#  后台任务（建帧索引 + 缩略图）
# ---------------------------------------------------------------------------
#WORKER_CONCURRENCY=2
#WORKER_POLL_INTERVAL_S=0.3
#READER_POOL_SIZE=8


# ---------------------------------------------------------------------------
#  Python 解释器（scripts\*.bat 用）
# ---------------------------------------------------------------------------
#  不写就自动探测：conda 的 work 环境 → PATH 里的 python。
#PYTHON_EXE=C:\Users\82188\miniconda3\envs\work\python.exe
