.index-container {
    min-height: 100vh;
    background-color: #f5f5f5;
}

.welcome-section {
    background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
    padding: 60rpx 40rpx;
    color: white;
}

.welcome-text {
    font-size: 28rpx;
    opacity: 0.8;
    margin-bottom: 8rpx;
}

.user-name {
    font-size: 40rpx;
    font-weight: bold;
}

.menu-section {
    padding: 30rpx;
}

.menu-item {
    display: flex;
    align-items: center;
    background-color: white;
    border-radius: 12rpx;
    padding: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.menu-icon {
    font-size: 48rpx;
    margin-right: 24rpx;
}

.menu-content {
    flex: 1;
}

.menu-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

.menu-desc {
    font-size: 24rpx;
    color: #999;
}

.admin-section {
    padding: 0 30rpx 30rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
}

.admin-menu {
    display: flex;
    justify-content: space-between;
}

.admin-item {
    flex: 1;
    background-color: white;
    border-radius: 12rpx;
    padding: 30rpx 20rpx;
    text-align: center;
    margin-right: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.admin-item:last-child {
    margin-right: 0;
}

.admin-icon {
    font-size: 48rpx;
    margin-bottom: 12rpx;
}

.admin-text {
    font-size: 28rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

.admin-desc {
    font-size: 22rpx;
    color: #999;
}
