<view class="password-container">
    <view class="password-form">
        <view class="input-group">
            <view class="input-label">旧密码 <text class="required">*</text></view>
            <input
                class="input-field"
                type="text"
                password="{{true}}"
                placeholder="请输入旧密码"
                value="{{oldPassword}}"
                bindinput="onOldPasswordInput"
            />
        </view>

        <view class="input-group">
            <view class="input-label">新密码 <text class="required">*</text></view>
            <input
                class="input-field"
                type="text"
                password="{{!showNewPassword}}"
                placeholder="请输入新密码（至少8位）"
                value="{{newPassword}}"
                bindinput="onNewPasswordInput"
            />
            <view class="password-toggle" bindtap="toggleNewPassword">
                <text>{{showNewPassword ? '隐藏' : '显示'}}</text>
            </view>
        </view>

        <view class="input-group">
            <view class="input-label">确认新密码 <text class="required">*</text></view>
            <input
                class="input-field"
                type="text"
                password="{{!showConfirmPassword}}"
                placeholder="请再次输入新密码"
                value="{{confirmPassword}}"
                bindinput="onConfirmPasswordInput"
            />
            <view class="password-toggle" bindtap="toggleConfirmPassword">
                <text>{{showConfirmPassword ? '隐藏' : '显示'}}</text>
            </view>
        </view>
    </view>

    <view class="submit-section">
        <button
            class="btn-primary submit-btn"
            bindtap="onSubmit"
            loading="{{loading}}"
            disabled="{{loading}}"
        >
            确认修改
        </button>
    </view>

    <view class="logout-section">
        <button
            class="btn-danger logout-btn"
            bindtap="onLogout"
        >
            退出登录
        </button>
    </view>
</view>
