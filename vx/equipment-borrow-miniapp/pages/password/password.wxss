.password-container {
    min-height: 100vh;
    background-color: #f5f5f5;
    padding: 20rpx;
}

.password-form {
    background-color: white;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.input-group {
    margin-bottom: 24rpx;
    position: relative;
}

.input-label {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 12rpx;
}

.required {
    color: #ff4d4f;
}

.input-field {
    width: 100%;
    height: 80rpx;
    border: 1rpx solid #d9d9d9;
    border-radius: 8rpx;
    padding: 0 20rpx;
    font-size: 28rpx;
    box-sizing: border-box;
}

.password-toggle {
    position: absolute;
    right: 20rpx;
    bottom: 20rpx;
    font-size: 24rpx;
    color: #1890ff;
}

.submit-section {
    margin-bottom: 20rpx;
}

.submit-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 32rpx;
}

.logout-section {
    margin-top: 40rpx;
}

.logout-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 32rpx;
}
