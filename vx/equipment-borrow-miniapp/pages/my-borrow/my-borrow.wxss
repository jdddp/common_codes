.my-borrow-container {
    min-height: 100vh;
    background-color: #f5f5f5;
}

.tab-bar {
    display: flex;
    background-color: white;
    padding: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 26rpx;
    color: #666;
    border-radius: 8rpx;
}

.tab-item.active {
    background-color: #1890ff;
    color: white;
}

.borrow-list {
    padding: 20rpx;
}

.borrow-card {
    background-color: white;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.borrow-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.device-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.borrow-status {
    font-size: 24rpx;
    padding: 4rpx 16rpx;
    border-radius: 16rpx;
}

.status-borrowing {
    background-color: #e6f7ff;
    color: #1890ff;
}

.status-partially_returned {
    background-color: #fff7e6;
    color: #faad14;
}

.status-returned {
    background-color: #f6ffed;
    color: #52c41a;
}

.borrow-info {
    display: flex;
    justify-content: space-around;
    padding: 20rpx 0;
    border-top: 1rpx solid #f0f0f0;
    border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
    text-align: center;
}

.info-label {
    font-size: 24rpx;
    color: #999;
    display: block;
    margin-bottom: 8rpx;
}

.info-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.borrow-time {
    padding: 16rpx 0;
}

.time-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8rpx;
}

.time-label {
    font-size: 24rpx;
    color: #999;
}

.time-value {
    font-size: 24rpx;
    color: #666;
}

.borrow-action {
    text-align: right;
    padding-top: 16rpx;
}

.return-btn {
    display: inline-block;
    width: 160rpx;
    height: 64rpx;
    line-height: 64rpx;
    font-size: 28rpx;
}

.empty-state {
    text-align: center;
    padding: 100rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}

.loading-more {
    text-align: center;
    padding: 20rpx;
}

.loading-text {
    font-size: 24rpx;
    color: #999;
}
