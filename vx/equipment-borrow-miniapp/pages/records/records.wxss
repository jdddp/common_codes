.records-container {
    min-height: 100vh;
    background-color: #f5f5f5;
}

.filter-section {
    background-color: white;
    padding: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.filter-row {
    display: flex;
    justify-content: space-between;
}

.filter-item {
    flex: 1;
    margin: 0 10rpx;
}

.filter-field {
    height: 64rpx;
    line-height: 64rpx;
    text-align: center;
    background-color: #f5f5f5;
    border-radius: 8rpx;
    font-size: 24rpx;
    color: #666;
}

.record-list {
    padding: 20rpx;
}

.record-card {
    background-color: white;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.record-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.device-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.record-status {
    font-size: 24rpx;
    padding: 4rpx 16rpx;
    border-radius: 16rpx;
}

.status-borrowing {
    background-color: #e6f7ff;
    color: #1890ff;
}

.status-partially_returned {
    background-color: #fff7e6;
    color: #faad14;
}

.status-returned {
    background-color: #f6ffed;
    color: #52c41a;
}

.record-info {
    display: flex;
    justify-content: space-around;
    padding: 20rpx 0;
    border-top: 1rpx solid #f0f0f0;
    border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
    text-align: center;
}

.info-label {
    font-size: 24rpx;
    color: #999;
    display: block;
    margin-bottom: 8rpx;
}

.info-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.record-time {
    padding: 16rpx 0;
}

.time-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8rpx;
}

.time-label {
    font-size: 24rpx;
    color: #999;
}

.time-value {
    font-size: 24rpx;
    color: #666;
}

.record-user {
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
}

.user-item {
    display: flex;
    justify-content: space-between;
}

.user-label {
    font-size: 24rpx;
    color: #999;
}

.user-value {
    font-size: 24rpx;
    color: #666;
}

.empty-state {
    text-align: center;
    padding: 100rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}

.loading-more {
    text-align: center;
    padding: 20rpx;
}

.loading-text {
    font-size: 24rpx;
    color: #999;
}
