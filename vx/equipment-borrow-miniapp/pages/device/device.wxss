.device-container {
    min-height: 100vh;
    background-color: #f5f5f5;
}

.search-bar {
    display: flex;
    padding: 20rpx;
    background-color: white;
}

.search-input {
    flex: 1;
    height: 72rpx;
    border: 1rpx solid #d9d9d9;
    border-radius: 8rpx;
    padding: 0 20rpx;
    font-size: 28rpx;
}

.search-btn {
    width: 120rpx;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    background-color: #1890ff;
    color: white;
    border-radius: 8rpx;
    margin-left: 16rpx;
    font-size: 28rpx;
}

.category-filter {
    background-color: white;
    padding: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.category-scroll {
    white-space: nowrap;
}

.category-item {
    display: inline-block;
    padding: 12rpx 24rpx;
    margin-right: 16rpx;
    border-radius: 32rpx;
    font-size: 26rpx;
    color: #666;
    background-color: #f5f5f5;
}

.category-item.active {
    background-color: #1890ff;
    color: white;
}

.device-list {
    padding: 20rpx;
}

.device-card {
    background-color: white;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.device-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.device-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.device-status {
    font-size: 24rpx;
    padding: 4rpx 16rpx;
    border-radius: 16rpx;
}

.status-active {
    background-color: #f6ffed;
    color: #52c41a;
}

.status-disabled {
    background-color: #fff2f0;
    color: #ff4d4f;
}

.device-info {
    display: flex;
    justify-content: space-around;
    margin-bottom: 20rpx;
    padding: 20rpx 0;
    border-top: 1rpx solid #f0f0f0;
    border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
    text-align: center;
}

.info-label {
    font-size: 24rpx;
    color: #999;
    display: block;
    margin-bottom: 8rpx;
}

.info-value {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.device-action {
    text-align: right;
}

.borrow-btn {
    display: inline-block;
    width: 160rpx;
    height: 64rpx;
    line-height: 64rpx;
    font-size: 28rpx;
}

.empty-state {
    text-align: center;
    padding: 100rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}

.loading-more {
    text-align: center;
    padding: 20rpx;
}

.loading-text {
    font-size: 24rpx;
    color: #999;
}
