.device-container {
    min-height: 100vh;
    background-color: #f5f5f5;
    padding-bottom: 40rpx;
}

.search-bar {
    display: flex;
    align-items: center;
    padding: 20rpx;
    background-color: white;
}

.search-input {
    flex: 1;
    height: 72rpx;
    background-color: #f5f5f5;
    border-radius: 36rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
}

.search-btn {
    margin-left: 16rpx;
    color: #1890ff;
    font-size: 28rpx;
    padding: 0 16rpx;
}

.device-tree {
    padding: 20rpx;
}

.tree-card {
    background-color: white;
    border-radius: 12rpx;
    margin-bottom: 16rpx;
    overflow: hidden;
}

.tree-card.level-1 {
    border-left: 6rpx solid #1890ff;
}

.tree-card.level-2 {
    margin: 0 16rpx 12rpx;
    background-color: #fafafa;
    border-left: 6rpx solid #52c41a;
}

.tree-card.level-3 {
    margin: 0 16rpx 10rpx;
    background-color: white;
    border-left: 6rpx solid #faad14;
}

.tree-header {
    display: flex;
    align-items: center;
    padding: 24rpx 20rpx;
}

.tree-header:active {
    background-color: rgba(0, 0, 0, 0.03);
}

.expand-icon {
    font-size: 24rpx;
    color: #999;
    margin-right: 12rpx;
    width: 24rpx;
}

.tree-name {
    font-size: 30rpx;
    color: #333;
    flex: 1;
}

.level-1 > .tree-header .tree-name {
    font-weight: bold;
    font-size: 32rpx;
}

.level-2 > .tree-header .tree-name {
    font-weight: 500;
}

.tree-children {
    padding: 0 0 8rpx;
}

.device-card {
    margin: 12rpx 20rpx;
    background-color: white;
    border-radius: 8rpx;
    padding: 20rpx;
    display: flex;
    align-items: center;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.device-path {
    display: none;
}

.device-main {
    flex: 1;
}

.device-name {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 8rpx;
}

.device-nums {
    display: flex;
}

.num-item {
    margin-right: 24rpx;
}

.num-label {
    font-size: 22rpx;
    color: #999;
    margin-right: 4rpx;
}

.num-value {
    font-size: 24rpx;
    color: #333;
}

.num-value.ok {
    color: #52c41a;
    font-weight: bold;
}

.device-action {
    margin-left: 16rpx;
}

.borrow-btn {
    font-size: 24rpx;
    color: white;
    background-color: #1890ff;
    border-radius: 8rpx;
    padding: 12rpx 24rpx;
    line-height: 1;
}

.borrow-btn[disabled] {
    background-color: #d9d9d9;
    color: #999;
}

.empty-state {
    text-align: center;
    padding: 100rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}
