<view class="device-container">
    <view class="search-bar">
        <input class="search-input" placeholder="搜索设备（支持所有层级）"
            value="{{keyword}}" bindinput="onSearchInput" bindconfirm="onSearch" />
        <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>

    <view class="device-tree" wx:if="{{filteredTree.length > 0}}">
        <block wx:for="{{filteredTree}}" wx:key="_id">
            <view class="tree-card level-1">
                <view class="tree-header" bindtap="onToggleNode" data-id="{{item._id}}">
                    <text class="expand-icon" wx:if="{{item.children.length > 0 || item.devices.length > 0}}">
                        {{item.expanded ? '▼' : '▶'}}
                    </text>
                    <text class="tree-name">{{item.name}}</text>
                </view>

                <view class="tree-children" wx:if="{{item.expanded}}">
                    <view wx:for="{{item.devices}}" wx:for-item="device" wx:key="_id" class="device-card">
                        <view class="device-path" wx:if="{{device.fullPath}}">{{device.fullPath}}</view>
                        <view class="device-main">
                            <view class="device-name">{{device.name}}</view>
                            <view class="device-nums">
                                <view class="num-item">
                                    <text class="num-label">可用</text>
                                    <text class="num-value ok">{{device.availableQuantity}}</text>
                                </view>
                                <view class="num-item">
                                    <text class="num-label">总数</text>
                                    <text class="num-value">{{device.totalQuantity}}</text>
                                </view>
                            </view>
                        </view>
                        <view class="device-action">
                            <button class="borrow-btn" bindtap="onBorrow" data-device="{{device}}"
                                disabled="{{device.availableQuantity <= 0}}">
                                {{device.availableQuantity > 0 ? '借用' : '暂无'}}
                            </button>
                        </view>
                    </view>

                    <view wx:for="{{item.children}}" wx:for-item="child" wx:key="_id" class="tree-card level-2">
                        <view class="tree-header" bindtap="onToggleNode" data-id="{{child._id}}">
                            <text class="expand-icon" wx:if="{{child.children.length > 0 || child.devices.length > 0}}">
                                {{child.expanded ? '▼' : '▶'}}
                            </text>
                            <text class="tree-name">{{child.name}}</text>
                        </view>

                        <view class="tree-children" wx:if="{{child.expanded}}">
                            <view wx:for="{{child.devices}}" wx:for-item="device" wx:key="_id" class="device-card">
                                <view class="device-path" wx:if="{{device.fullPath}}">{{device.fullPath}}</view>
                                <view class="device-main">
                                    <view class="device-name">{{device.name}}</view>
                                    <view class="device-nums">
                                        <view class="num-item">
                                            <text class="num-label">可用</text>
                                            <text class="num-value ok">{{device.availableQuantity}}</text>
                                        </view>
                                        <view class="num-item">
                                            <text class="num-label">总数</text>
                                            <text class="num-value">{{device.totalQuantity}}</text>
                                        </view>
                                    </view>
                                </view>
                                <view class="device-action">
                                    <button class="borrow-btn" bindtap="onBorrow" data-device="{{device}}"
                                        disabled="{{device.availableQuantity <= 0}}">
                                        {{device.availableQuantity > 0 ? '借用' : '暂无'}}
                                    </button>
                                </view>
                            </view>

                            <view wx:for="{{child.children}}" wx:for-item="gchild" wx:key="_id" class="tree-card level-3">
                                <view class="tree-header" bindtap="onToggleNode" data-id="{{gchild._id}}">
                                    <text class="expand-icon" wx:if="{{gchild.devices.length > 0}}">
                                        {{gchild.expanded ? '▼' : '▶'}}
                                    </text>
                                    <text class="tree-name">{{gchild.name}}</text>
                                </view>
                                <view class="tree-children" wx:if="{{gchild.expanded}}">
                                    <view wx:for="{{gchild.devices}}" wx:for-item="device" wx:key="_id" class="device-card">
                                        <view class="device-path" wx:if="{{device.fullPath}}">{{device.fullPath}}</view>
                                        <view class="device-main">
                                            <view class="device-name">{{device.name}}</view>
                                            <view class="device-nums">
                                                <view class="num-item">
                                                    <text class="num-label">可用</text>
                                                    <text class="num-value ok">{{device.availableQuantity}}</text>
                                                </view>
                                                <view class="num-item">
                                                    <text class="num-label">总数</text>
                                                    <text class="num-value">{{device.totalQuantity}}</text>
                                                </view>
                                            </view>
                                        </view>
                                        <view class="device-action">
                                            <button class="borrow-btn" bindtap="onBorrow" data-device="{{device}}"
                                                disabled="{{device.availableQuantity <= 0}}">
                                                {{device.availableQuantity > 0 ? '借用' : '暂无'}}
                                            </button>
                                        </view>
                                    </view>
                                </view>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </block>
    </view>

    <view class="empty-state" wx:if="{{filteredTree.length === 0 && !loading}}">
        <view class="empty-icon">📭</view>
        <view class="empty-text">{{keyword ? '未找到匹配设备' : '暂无设备'}}</view>
    </view>
</view>
