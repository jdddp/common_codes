<view class="admin-user-container">
    <view class="header-section">
        <view class="search-bar">
            <input
                class="search-input"
                placeholder="搜索用户"
                value="{{keyword}}"
                bindinput="onSearchInput"
                bindconfirm="onSearch"
            />
            <button class="btn-primary add-btn" bindtap="onAddUser">新增用户</button>
        </view>
    </view>

    <view class="user-list">
        <view
            wx:for="{{users}}"
            wx:key="_id"
            class="user-card"
        >
            <view class="user-header">
                <view class="user-name">{{item.name}}</view>
                <view class="user-status {{item.status === 'active' ? 'status-active' : 'status-disabled'}}">
                    {{item.status === 'active' ? '正常' : '已禁用'}}
                </view>
            </view>

            <view class="user-info">
                <view class="info-row">
                    <text class="info-label">手机号</text>
                    <text class="info-value">{{item.phone}}</text>
                </view>
                <view class="info-row">
                    <text class="info-label">部门</text>
                    <text class="info-value">{{item.department || '-'}}</text>
                </view>
                <view class="info-row">
                    <text class="info-label">角色</text>
                    <text class="info-value">{{item.role === 'admin' ? '管理员' : '普通用户'}}</text>
                </view>
            </view>

            <view class="user-actions">
                <text class="action-btn" catchtap="onEditUser" data-user="{{item}}">编辑</text>
                <text class="action-btn" catchtap="onResetPassword" data-user="{{item}}">重置密码</text>
                <text
                    class="action-btn {{item.status === 'active' ? 'text-danger' : 'text-success'}}"
                    catchtap="onToggleUserStatus"
                    data-user="{{item}}"
                >
                    {{item.status === 'active' ? '禁用' : '启用'}}
                </text>
            </view>
        </view>

        <view class="empty-state" wx:if="{{users.length === 0 && !loading}}">
            <view class="empty-icon">👥</view>
            <view class="empty-text">暂无用户</view>
        </view>
    </view>

    <view class="loading-more" wx:if="{{loading}}">
        <view class="loading-text">加载中...</view>
    </view>
</view>
