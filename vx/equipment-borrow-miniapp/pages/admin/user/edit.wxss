.edit-container {
    padding: 30rpx;
}

.form-group {
    margin-bottom: 30rpx;
}

.form-label {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 12rpx;
}

.form-input {
    width: 100%;
    height: 80rpx;
    border: 1px solid #ddd;
    border-radius: 8rpx;
    padding: 0 20rpx;
    font-size: 28rpx;
    box-sizing: border-box;
}

.picker-input {
    line-height: 80rpx;
    color: #333;
}

.submit-btn {
    margin-top: 50rpx;
    background-color: #1890ff;
    color: #fff;
    border-radius: 8rpx;
    font-size: 32rpx;
}
