<view class="admin-device-container">
    <view class="header-section">
        <view class="section-title">设备管理</view>
        <view class="header-actions">
            <button class="btn-primary add-btn" bindtap="onAddCategory">新增分类</button>
            <button class="btn-primary add-btn" bindtap="onAddDevice">新增设备</button>
        </view>
    </view>

    <view class="category-tree">
        <view
            wx:for="{{categories}}"
            wx:key="_id"
            class="category-level-1"
        >
            <view class="category-item" bindtap="onCategoryTap" data-category="{{item}}">
                <view class="category-name">
                    <text class="expand-icon">{{item.expanded ? '▼' : '▶'}}</text>
                    {{item.name}}
                </view>
                <view class="category-actions">
                    <text class="action-btn" catchtap="onEditCategory" data-category="{{item}}">编辑</text>
                </view>
            </view>

            <view class="sub-categories" wx:if="{{item.expanded}}">
                <view
                    wx:for="{{item.children}}"
                    wx:for-item="child"
                    wx:key="_id"
                    class="category-level-2"
                >
                    <view class="category-item" bindtap="onSubCategoryTap" data-category="{{child}}">
                        <view class="category-name">
                            <text class="expand-icon">{{child.expanded ? '▼' : '▶'}}</text>
                            {{child.name}}
                        </view>
                        <view class="category-actions">
                            <text class="action-btn" catchtap="onEditCategory" data-category="{{child}}">编辑</text>
                        </view>
                    </view>

                    <view class="device-list" wx:if="{{child.expanded}}">
                        <view
                            wx:for="{{child.devices}}"
                            wx:for-item="device"
                            wx:key="_id"
                            class="device-item"
                        >
                            <view class="device-info">
                                <view class="device-name">{{device.name}}</view>
                                <view class="device-quantity">
                                    <text>总数：{{device.totalQuantity}}</text>
                                    <text>已借：{{device.borrowedQuantity}}</text>
                                    <text>可用：{{device.availableQuantity}}</text>
                                </view>
                            </view>
                            <view class="device-actions">
                                <text class="action-btn" catchtap="onEditDevice" data-device="{{device}}">编辑</text>
                                <text class="action-btn" catchtap="onUpdateQuantity" data-device="{{device}}">数量</text>
                                <text
                                    class="action-btn {{device.status === 'active' ? 'text-danger' : 'text-success'}}"
                                    catchtap="onToggleDeviceStatus"
                                    data-device="{{device}}"
                                >
                                    {{device.status === 'active' ? '禁用' : '启用'}}
                                </text>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>

    <view class="empty-state" wx:if="{{categories.length === 0 && !loading}}">
        <view class="empty-icon">📭</view>
        <view class="empty-text">暂无分类</view>
    </view>
</view>
