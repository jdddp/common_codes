<view class="admin-device-container">
    <view class="header-section">
        <view class="section-title">设备管理</view>
        <button class="btn-primary add-btn" bindtap="onAddCategory" data-parentid="" data-level="1">新增分类</button>
    </view>

    <view class="category-tree" wx:if="{{tree.length > 0}}">
        <block wx:for="{{tree}}" wx:key="_id">
            <view class="cat-card level-1">
                <view class="cat-header" bindtap="onToggleNode" data-id="{{item._id}}">
                    <text class="expand-icon" wx:if="{{item.children.length > 0}}">{{item.expanded ? '▼' : '▶'}}</text>
                    <text class="cat-name">{{item.name}}</text>
                </view>
                <view class="device-nums" wx:if="{{item.device}}">
                    <view class="num-item"><text class="num-label">总数</text><text class="num-value">{{item.device.totalQuantity}}</text></view>
                    <view class="num-item"><text class="num-label">已借</text><text class="num-value warn">{{item.device.borrowedQuantity}}</text></view>
                    <view class="num-item"><text class="num-label">可用</text><text class="num-value ok">{{item.device.availableQuantity}}</text></view>
                </view>
                <view class="cat-actions">
                    <text class="act-btn" catchtap="onEditCategory" data-category="{{item}}">编辑</text>
                    <text class="act-btn green" catchtap="onAddCategory" data-parentid="{{item._id}}" data-level="2">+子分类</text>
                    <text class="act-btn orange" wx:if="{{item.children.length === 0}}" catchtap="onQuantitySet" data-id="{{item._id}}">数量设置</text>
                    <text class="act-btn red" catchtap="onDeleteCategory" data-category="{{item}}">删除</text>
                </view>

                <view class="cat-children" wx:if="{{item.expanded}}">
                    <view wx:for="{{item.children}}" wx:for-item="child" wx:key="_id" class="cat-card level-2">
                        <view class="cat-header" bindtap="onToggleNode" data-id="{{child._id}}">
                            <text class="expand-icon" wx:if="{{child.children.length > 0}}">{{child.expanded ? '▼' : '▶'}}</text>
                            <text class="cat-name">{{child.name}}</text>
                        </view>
                        <view class="device-nums" wx:if="{{child.device}}">
                            <view class="num-item"><text class="num-label">总数</text><text class="num-value">{{child.device.totalQuantity}}</text></view>
                            <view class="num-item"><text class="num-label">已借</text><text class="num-value warn">{{child.device.borrowedQuantity}}</text></view>
                            <view class="num-item"><text class="num-label">可用</text><text class="num-value ok">{{child.device.availableQuantity}}</text></view>
                        </view>
                        <view class="cat-actions">
                            <text class="act-btn" catchtap="onEditCategory" data-category="{{child}}">编辑</text>
                            <text class="act-btn green" catchtap="onAddCategory" data-parentid="{{child._id}}" data-level="3">+子分类</text>
                            <text class="act-btn orange" wx:if="{{child.children.length === 0}}" catchtap="onQuantitySet" data-id="{{child._id}}">数量设置</text>
                            <text class="act-btn red" catchtap="onDeleteCategory" data-category="{{child}}">删除</text>
                        </view>

                        <view class="cat-children" wx:if="{{child.expanded}}">
                            <view wx:for="{{child.children}}" wx:for-item="gchild" wx:key="_id" class="cat-card level-3">
                                <view class="cat-header">
                                    <text class="cat-name">{{gchild.name}}</text>
                                </view>
                                <view class="device-nums" wx:if="{{gchild.device}}">
                                    <view class="num-item"><text class="num-label">总数</text><text class="num-value">{{gchild.device.totalQuantity}}</text></view>
                                    <view class="num-item"><text class="num-label">已借</text><text class="num-value warn">{{gchild.device.borrowedQuantity}}</text></view>
                                    <view class="num-item"><text class="num-label">可用</text><text class="num-value ok">{{gchild.device.availableQuantity}}</text></view>
                                </view>
                                <view class="cat-actions">
                                    <text class="act-btn" catchtap="onEditCategory" data-category="{{gchild}}">编辑</text>
                                    <text class="act-btn orange" catchtap="onQuantitySet" data-id="{{gchild._id}}">数量设置</text>
                                    <text class="act-btn red" catchtap="onDeleteCategory" data-category="{{gchild}}">删除</text>
                                </view>
                            </view>
                        </view>
                    </view>
                </view>
            </view>
        </block>
    </view>

    <view class="empty-state" wx:if="{{tree.length === 0 && !loading}}">
        <view class="empty-icon">📭</view>
        <view class="empty-text">暂无分类，请先新增分类</view>
    </view>
</view>
