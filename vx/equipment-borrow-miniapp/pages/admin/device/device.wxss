.admin-device-container {
    min-height: 100vh;
    background-color: #f5f5f5;
    padding-bottom: 40rpx;
}

.header-section {
    background-color: white;
    padding: 24rpx;
    margin-bottom: 20rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.add-btn {
    width: 180rpx;
    height: 60rpx;
    line-height: 60rpx;
    font-size: 26rpx;
}

.category-tree {
    padding: 0 20rpx;
}

/* 一级分类 */
.cat-card.level-1 {
    background-color: white;
    border-radius: 12rpx;
    margin-bottom: 16rpx;
    border-left: 6rpx solid #1890ff;
}

/* 二级分类 */
.cat-card.level-2 {
    margin: 0 16rpx 12rpx;
    background-color: #fafafa;
    border-radius: 8rpx;
    border-left: 6rpx solid #52c41a;
}

/* 三级 = 设备 */
.cat-card.level-3 {
    margin: 0 16rpx 12rpx;
    background-color: white;
    border-radius: 8rpx;
    border-left: 6rpx solid #faad14;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.cat-header {
    display: flex;
    align-items: center;
    padding: 24rpx 20rpx;
}

.expand-icon {
    font-size: 24rpx;
    color: #999;
    margin-right: 12rpx;
    width: 24rpx;
}

.cat-name {
    font-size: 30rpx;
    color: #333;
    flex: 1;
}

.level-1 > .cat-header .cat-name {
    font-weight: bold;
    font-size: 32rpx;
}

.level-2 > .cat-header .cat-name {
    font-weight: 500;
}

.level-3 > .cat-header .cat-name {
    font-weight: 500;
    font-size: 30rpx;
}

.cat-tag {
    font-size: 20rpx;
    padding: 4rpx 12rpx;
    border-radius: 4rpx;
}

.tag-1 {
    background-color: #e6f7ff;
    color: #1890ff;
}

.tag-2 {
    background-color: #f6ffed;
    color: #52c41a;
}

.tag-3 {
    background-color: #fffbe6;
    color: #faad14;
}

.tag-device {
    background-color: #fff1f0;
    color: #ff4d4f;
    font-weight: 500;
}

.cat-actions {
    display: flex;
    flex-wrap: wrap;
    padding: 12rpx 20rpx 16rpx;
    border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.act-btn {
    font-size: 24rpx;
    color: #1890ff;
    margin-right: 28rpx;
}

.act-btn.green {
    color: #52c41a;
}

.act-btn.blue {
    color: #1890ff;
    font-weight: 500;
}

.act-btn.orange {
    color: #faad14;
    font-weight: 500;
}

.act-btn.red {
    color: #ff4d4f;
}

.cat-children {
    padding: 0 0 8rpx;
}

/* 设备信息 */
.device-info {
    padding: 16rpx 20rpx 8rpx;
}

.device-nums {
    display: flex;
    justify-content: space-around;
    background-color: #fafafa;
    border-radius: 8rpx;
    padding: 16rpx 0;
}

.num-item {
    text-align: center;
}

.num-label {
    font-size: 22rpx;
    color: #999;
    display: block;
    margin-bottom: 8rpx;
}

.num-value {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

.num-value.warn {
    color: #faad14;
}

.num-value.ok {
    color: #52c41a;
}

.add-device-hint, .add-child-hint {
    text-align: center;
    padding: 20rpx;
    color: #1890ff;
    font-size: 26rpx;
}

.add-device-hint:active, .add-child-hint:active {
    background-color: rgba(0, 0, 0, 0.02);
}

.empty-state {
    text-align: center;
    padding: 100rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}
