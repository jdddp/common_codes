.admin-device-container {
    min-height: 100vh;
    background-color: #f5f5f5;
}

.header-section {
    background-color: white;
    padding: 24rpx;
    margin-bottom: 20rpx;
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
}

.header-actions {
    display: flex;
    justify-content: flex-end;
}

.add-btn {
    width: 200rpx;
    height: 64rpx;
    line-height: 64rpx;
    font-size: 26rpx;
    margin-left: 16rpx;
}

.category-tree {
    padding: 0 20rpx;
}

.category-level-1 {
    background-color: white;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
    overflow: hidden;
}

.category-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.category-name {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    flex: 1;
}

.expand-icon {
    font-size: 24rpx;
    color: #999;
    margin-right: 12rpx;
}

.category-actions {
    display: flex;
}

.action-btn {
    font-size: 24rpx;
    color: #1890ff;
    margin-left: 24rpx;
}

.sub-categories {
    background-color: #fafafa;
}

.category-level-2 .category-item {
    padding-left: 60rpx;
}

.device-list {
    padding: 0 60rpx 20rpx;
}

.device-item {
    background-color: white;
    border-radius: 8rpx;
    padding: 20rpx;
    margin-bottom: 12rpx;
}

.device-info {
    margin-bottom: 12rpx;
}

.device-name {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 8rpx;
}

.device-quantity {
    display: flex;
    font-size: 24rpx;
    color: #666;
}

.device-quantity text {
    margin-right: 20rpx;
}

.device-actions {
    display: flex;
    justify-content: flex-end;
}

.text-danger {
    color: #ff4d4f;
}

.text-success {
    color: #52c41a;
}

.empty-state {
    text-align: center;
    padding: 100rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #999;
}
