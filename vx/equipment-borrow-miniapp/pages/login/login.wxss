.login-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40rpx;
    background-color: #f5f5f5;
}

.login-header {
    text-align: center;
    margin-bottom: 60rpx;
}

.login-title {
    font-size: 48rpx;
    font-weight: bold;
    color: #1890ff;
    margin-bottom: 16rpx;
}

.login-subtitle {
    font-size: 28rpx;
    color: #666;
}

.login-form {
    background-color: white;
    border-radius: 16rpx;
    padding: 40rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.input-group {
    margin-bottom: 32rpx;
    position: relative;
}

.input-label {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 12rpx;
}

.input-field {
    width: 100%;
    height: 80rpx;
    border: 1rpx solid #d9d9d9;
    border-radius: 8rpx;
    padding: 0 20rpx;
    font-size: 28rpx;
    box-sizing: border-box;
}

.input-field:focus {
    border-color: #1890ff;
}

.password-toggle {
    position: absolute;
    right: 20rpx;
    bottom: 20rpx;
    font-size: 24rpx;
    color: #1890ff;
}

.login-btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 32rpx;
    margin-top: 20rpx;
}
