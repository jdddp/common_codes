page {
    background-color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
    padding: 20rpx;
}

.btn-primary {
    background-color: #1890ff;
    color: white;
    border-radius: 8rpx;
    padding: 20rpx;
    text-align: center;
    border: none;
}

.btn-primary:active {
    background-color: #096dd9;
}

.btn-danger {
    background-color: #ff4d4f;
    color: white;
    border-radius: 8rpx;
    padding: 20rpx;
    text-align: center;
    border: none;
}

.card {
    background-color: white;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.input-group {
    margin-bottom: 24rpx;
}

.input-label {
    font-size: 28rpx;
    color: #333;
    margin-bottom: 12rpx;
}

.input-field {
    border: 1rpx solid #d9d9d9;
    border-radius: 8rpx;
    padding: 16rpx 20rpx;
    font-size: 28rpx;
}

.input-field:focus {
    border-color: #1890ff;
}

.text-success {
    color: #52c41a;
}

.text-danger {
    color: #ff4d4f;
}

.text-warning {
    color: #faad14;
}

.text-muted {
    color: #999;
}
